# Expo embute no bundle apenas variáveis EXPO_PUBLIC_* (use estas no app).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_OU_PUBLISHABLE

# Sem login temporario: edite `src/lib/bypass-auth.ts` (bypassAuth = true | false).

# Se você veio de um projeto Next.js, pode copiar os valores acima a partir de:
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# (o código também lê NEXT_PUBLIC_* em runtime quando expostas ao bundle.)
